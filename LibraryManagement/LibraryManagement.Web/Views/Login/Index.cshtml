@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập — Thư viện THCS Thanh Xuân</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
            * {
                box-sizing: border-box;
            }

            html, body {
                height: 100%;
                margin: 0;
            }

            .login-wrapper {
                display: flex;
                min-height: 100vh;
            }

            /* ── Cột trái: hình trường ── */
            .login-hero {
                flex: 0 0 60%;
                max-width: 60%;
                background: linear-gradient(160deg, #0d5c2e 0%, #1a8c4a 50%, #25b05e 100%);
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                padding: 2.5rem 3rem;
                position: relative;
                overflow: hidden;
            }

                .login-hero::before {
                    content: '';
                    position: absolute;
                    inset: 0;
                    background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.04'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
                }

            .school-logo {
                width: 150px;
                height: 150px;
                object-fit: contain;
                background: #fff;
                border-radius: 50%;
                padding: 6px;
                box-shadow: 0 0 0 6px rgba(255,255,255,0.18), 0 8px 28px rgba(0,0,0,0.25);
                margin-bottom: 1.5rem;
                position: relative;
                z-index: 1;
            }

            .hero-title {
                color: #fff;
                font-size: 1.6rem;
                font-weight: 800;
                text-align: center;
                line-height: 1.3;
                position: relative;
                z-index: 1;
                text-shadow: 0 2px 8px rgba(0,0,0,0.2);
            }

            .hero-subtitle {
                color: rgba(255,255,255,0.8);
                font-size: 0.95rem;
                text-align: center;
                margin-top: 0.5rem;
                position: relative;
                z-index: 1;
            }

            .hero-stats {
                display: flex;
                gap: 1.5rem;
                margin-top: 2.5rem;
                position: relative;
                z-index: 1;
            }

            .hero-stat {
                background: rgba(255,255,255,0.12);
                border: 1px solid rgba(255,255,255,0.2);
                border-radius: 12px;
                padding: 0.8rem 1.2rem;
                text-align: center;
                color: #fff;
                min-width: 90px;
            }

            .hero-stat-num {
                font-size: 1.4rem;
                font-weight: 800;
                display: block;
            }

            .hero-stat-label {
                font-size: 0.72rem;
                opacity: 0.8;
                display: block;
            }

            .hero-decoration {
                position: absolute;
                bottom: -40px;
                right: -40px;
                width: 240px;
                height: 240px;
                background: rgba(255,255,255,0.05);
                border-radius: 50%;
            }

            .hero-decoration-2 {
                position: absolute;
                top: -60px;
                left: -60px;
                width: 300px;
                height: 300px;
                background: rgba(255,255,255,0.04);
                border-radius: 50%;
            }

            /* ── Cột phải: form ── */
            .login-panel {
                flex: 0 0 40%;
                max-width: 40%;
                background: #fff;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 2rem 2.5rem;
            }

            .login-form-box {
                width: 100%;
                max-width: 400px;
                margin: 0 auto;
            }

                .login-form-box h5 {
                    font-size: 1.35rem;
                    font-weight: 700;
                    color: #1a1a1a;
                }

            .form-control:focus {
                border-color: #1a8c4a;
                box-shadow: 0 0 0 .2rem rgba(26,140,74,.2);
            }

            .btn-login {
                background: linear-gradient(135deg, #1a8c4a, #0d5c2e);
                border: none;
                font-weight: 600;
                letter-spacing: .3px;
                padding: .7rem;
                transition: opacity .2s;
            }

                .btn-login:hover {
                    opacity: .9;
                }

            .input-group-text {
                background: #f8f9fa;
                border-right: none;
            }

            .input-group .form-control {
                border-left: none;
            }

                .input-group .form-control:focus {
                    box-shadow: none;
                    border-color: #1a8c4a;
                }

            .input-group:focus-within .input-group-text {
                border-color: #1a8c4a;
            }

            /* Mobile: collapse hero thành header nhỏ */
            @@media (max-width: 767.98px) {
                .login-hero {
                    flex: none;
                    max-width: 100%;
                    padding: 1.5rem;
                    min-height: 180px;
                }

                .school-logo {
                    width: 84px;
                    height: 84px;
                    padding: 4px;
                    margin-bottom: .8rem;
                }

                .hero-title {
                    font-size: 1.1rem;
                }

                .hero-stats {
                    display: none;
                }

                .login-panel {
                    flex: none;
                    max-width: 100%;
                    width: 100%;
                    padding: 1.5rem;
                }

                .login-wrapper {
                    flex-direction: column;
                }
            }
    </style>
</head>
<body>
    <div class="login-wrapper">

        <!-- Cột trái: hình ảnh trường -->
        <div class="login-hero">
            <div class="hero-decoration-2"></div>
            <div class="hero-decoration"></div>

            <img src="~/Img/Logo.png" alt="Logo Trường THCS Thanh Xuân" class="school-logo" asp-append-version="true" />

            <div class="hero-title">
                HỆ THỐNG QUẢN LÝ THƯ VIÊN <br /> TRƯỜNG THCS THANH XUÂN
            </div>
            <div class="hero-subtitle">
                <i class="bi bi-geo-alt-fill me-1"></i>Phường Thanh Xuân - Tp. Hà Nội
            </div>

            <div class="hero-stats">
                <div class="hero-stat">
                    <span class="hero-stat-num"><i class="bi bi-book-fill" style="font-size:1.2rem"></i></span>
                    <span class="hero-stat-label">Kho sách</span>
                </div>
                <div class="hero-stat">
                    <span class="hero-stat-num"><i class="bi bi-people-fill" style="font-size:1.2rem"></i></span>
                    <span class="hero-stat-label">Độc giả</span>
                </div>
                <div class="hero-stat">
                    <span class="hero-stat-num"><i class="bi bi-clipboard2-check-fill" style="font-size:1.2rem"></i></span>
                    <span class="hero-stat-label">Mượn sách</span>
                </div>
                <div class="hero-stat">
                    <span class="hero-stat-num"><i class="bi bi-file-earmark-text-fill" style="font-size:1.2rem"></i></span>
                    <span class="hero-stat-label">Trả sách</span>
                </div>
                <div class="hero-stat">
                    <span class="hero-stat-num"><i class="bi bi-bar-chart-fill" style="font-size:1.2rem"></i></span>
                    <span class="hero-stat-label">Báo cáo</span>
                </div>
            </div>
        </div>

        <!-- Cột phải: form đăng nhập -->
        <div class="login-panel">
            <div class="login-form-box">
                <div class="mb-1">
                    <span class="badge bg-success-subtle text-success rounded-pill px-3 py-1 small">
                        <i class="bi bi-lock-fill me-1"></i>Hệ thống nội bộ
                    </span>
                </div>
                <h5 class="mt-3 mb-1">Đăng nhập</h5>
                <p class="text-muted small mb-4">Nhập thông tin tài khoản để tiếp tục.</p>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2 small">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        @Html.ValidationSummary(false, "", new { @class = "mb-0" })
                    </div>
                }

                <form asp-action="Index" asp-controller="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Tên đăng nhập</label>
                        <div class="input-group">
                            <span class="input-group-text text-muted">
                                <i class="bi bi-person-fill"></i>
                            </span>
                            <input type="text" name="tenDangNhap" class="form-control"
                                   placeholder="Tên đăng nhập" required autofocus />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold small">Mật khẩu</label>
                        <div class="input-group">
                            <span class="input-group-text text-muted">
                                <i class="bi bi-lock-fill"></i>
                            </span>
                            <input type="password" name="matKhau" id="matKhau"
                                   class="form-control" placeholder="Mật khẩu" required />
                            <button type="button" class="btn btn-outline-secondary border-start-0"
                                    onclick="togglePwd()" title="Hiện/ẩn mật khẩu">
                                <i class="bi bi-eye" id="eyeIcon"></i>
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-login btn-success w-100 text-white">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Đăng nhập
                    </button>
                </form>

                <hr class="my-4" />
                <p class="text-center text-muted" style="font-size:.78rem">
                    <i class="bi bi-info-circle me-1"></i>
                    Liên hệ quản trị viên nếu quên mật khẩu.
                </p>
            </div>
        </div>
    </div>

    <script>
            function togglePwd() {
                const inp = document.getElementById('matKhau');
                const ico = document.getElementById('eyeIcon');
                if (inp.type === 'password') {
                    inp.type = 'text';
                    ico.className = 'bi bi-eye-slash';
                } else {
                    inp.type = 'password';
                    ico.className = 'bi bi-eye';
                }
            }
    </script>
</body>
</html>
