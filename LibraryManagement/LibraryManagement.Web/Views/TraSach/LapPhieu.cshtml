@using LibraryManagement.Application.DTOs.MuonSach
@{
    ViewData["Title"] = "Lập phiếu trả sách";
    var pm = ViewBag.PhieuMuon as PhieuMuonDetailDto;
    decimal mucPhat = ViewBag.MucPhat ?? 0m;
    bool coTheTra = pm != null && pm.TrangThai is 1 or 3 or 4;
    decimal phatTreHan = pm == null ? 0 : pm.SoNgayTreHan * mucPhat;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold mb-0"><i class="bi bi-arrow-return-left me-2 text-success"></i>Lập phiếu trả sách</h4>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Quay lại
    </a>
</div>

<!-- Tìm phiếu mượn -->
<div class="card shadow-sm mb-3">
    <div class="card-body py-2">
        <form method="get" asp-action="LapPhieu" class="row g-2 align-items-end">
            <div class="col-sm-6 col-md-4">
                <label class="form-label small mb-1">Mã phiếu mượn</label>
                <input type="number" name="maPhieuMuon" class="form-control form-control-sm" min="1" required
                       value="@pm?.MaPhieuMuon" placeholder="Nhập mã phiếu mượn..." />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="bi bi-search me-1"></i>Tìm phiếu
                </button>
            </div>
            <div class="col-auto">
                <a asp-controller="MuonSach" asp-action="Index" class="btn btn-link btn-sm">
                    Xem danh sách phiếu mượn
                </a>
            </div>
        </form>
    </div>
</div>

@if (pm != null)
{
    <div class="row g-3">
        <!-- Thông tin phiếu mượn -->
        <div class="col-md-7">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-success-subtle fw-semibold d-flex justify-content-between">
                    <span><i class="bi bi-file-earmark-text me-1"></i>Phiếu mượn #@pm.MaPhieuMuon</span>
                    <span class="badge @(pm.SoNgayTreHan > 0 && coTheTra ? "bg-danger" : "bg-secondary")">@pm.TrangThaiText</span>
                </div>
                <div class="card-body">
                    <dl class="row small mb-3">
                        <dt class="col-4 text-muted">Độc giả</dt>
                        <dd class="col-8 fw-semibold">@pm.TenDocGia <span class="badge bg-secondary ms-1">@pm.Lop</span></dd>

                        <dt class="col-4 text-muted">Ngày mượn</dt>
                        <dd class="col-8">@pm.NgayMuon.ToString("dd/MM/yyyy")</dd>

                        <dt class="col-4 text-muted">Hạn trả</dt>
                        <dd class="col-8">
                            @pm.NgayHanTra.ToString("dd/MM/yyyy")
                            @if (pm.SoNgayTreHan > 0 && coTheTra)
                            {
                                <span class="badge bg-danger ms-1">Trễ @pm.SoNgayTreHan ngày</span>
                            }
                        </dd>

                        <dt class="col-4 text-muted">Ngày trả hôm nay</dt>
                        <dd class="col-8 fw-semibold text-success">
                            <i class="bi bi-calendar-check me-1"></i>@DateTime.Today.ToString("dd/MM/yyyy")
                        </dd>
                    </dl>

                    <table class="table table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Tên sách</th>
                                <th>Tác giả</th>
                                <th>Vị trí</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in pm.DanhSachSach)
                            {
                                <tr>
                                    <td class="fw-semibold">@s.TenSach</td>
                                    <td class="small text-muted">@s.TenTacGia</td>
                                    <td class="small text-muted">@(s.ViTri ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Form trả sách -->
        <div class="col-md-5">
            @if (!coTheTra)
            {
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    Phiếu mượn này đã được trả hoặc không thể xử lý (trạng thái: @pm.TrangThaiText).
                </div>
            }
            else
            {
                @if (phatTreHan > 0)
                {
                    <div class="alert alert-danger d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-exclamation-octagon-fill fs-5"></i>
                        <div>
                            <strong>Phiếu trễ hạn @pm.SoNgayTreHan ngày!</strong><br />
                            Tiền phạt ước tính: <span class="fw-bold">@phatTreHan.ToString("N0") đồng</span>
                            <span class="small text-muted">(@mucPhat.ToString("N0") đ/ngày)</span>
                        </div>
                    </div>
                }

                <div class="card shadow-sm">
                    <div class="card-header bg-success text-white py-2">
                        <i class="bi bi-arrow-return-left me-1"></i>Xác nhận trả sách
                    </div>
                    <div class="card-body">
                        <form method="post" asp-action="LapPhieu">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="maPhieuMuon" value="@pm.MaPhieuMuon" />

                            <div class="mb-3">
                                <label class="form-label fw-semibold small">Tình trạng sách trả <span class="text-danger">*</span></label>
                                <select name="trangThaiSach" class="form-select form-select-sm" required>
                                    <option value="1">Tốt — nguyên vẹn</option>
                                    <option value="2">Hơi cũ / bẩn nhẹ</option>
                                    <option value="3">Hư hỏng một phần</option>
                                    <option value="4">Hư hỏng nặng / mất sách</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold small">Ghi chú</label>
                                <textarea name="ghiChu" class="form-control form-control-sm" rows="2"
                                          placeholder="Ghi chú thêm..."></textarea>
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-success">
                                    <i class="bi bi-check-circle me-1"></i>Xác nhận trả sách
                                </button>
                                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Hủy</a>
                            </div>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
}
