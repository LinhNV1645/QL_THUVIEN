@{
    ViewData["Title"] = "Lập phiếu trả sách";
    var pm = ViewBag.PhieuMuon as PhieuMuonDetailDto;
    decimal mucPhat = ViewBag.MucPhat ?? 0m;
    bool coTheTra = pm != null && pm.TrangThai is 1 or 3 or 4;
    decimal phatTreHan = pm == null ? 0 : pm.SoNgayTreHan * mucPhat;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold mb-0"><i class="bi bi-arrow-return-left me-2 text-success"></i>Lập phiếu trả sách</h4>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Quay lại
    </a>
</div>

<!-- Tìm phiếu mượn -->
<div class="card shadow-sm mb-3">
    <div class="card-body py-2">
        <form method="get" asp-action="LapPhieu" class="row g-2 align-items-end">
            <div class="col-sm-6 col-md-4">
                <label class="form-label small mb-1">Mã phiếu mượn</label>
                <input type="number" name="maPhieuMuon" class="form-control form-control-sm" min="1" required
                       value="@pm?.MaPhieuMuon" placeholder="Nhập mã phiếu mượn..." />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="bi bi-search me-1"></i>Tìm phiếu
                </button>
            </div>
            <div class="col-auto">
                <a asp-controller="MuonSach" asp-action="Index" class="btn btn-link btn-sm">
                    Xem danh sách phiếu mượn
                </a>
            </div>
        </form>
    </div>
</div>

@if (pm != null)
{
    <div class="row g-3">
        <!-- Thông tin phiếu mượn -->
        <div class="col-md-7">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-success-subtle fw-semibold d-flex justify-content-between">
                    <span><i class="bi bi-file-earmark-text me-1"></i>Phiếu mượn #@pm.MaPhieuMuon</span>
                    <span class="badge @(pm.SoNgayTreHan > 0 && coTheTra ? "bg-danger" : "bg-secondary")">@pm.TrangThaiText</span>
                </div>
                <div class="card-body">
                    <dl class="row small mb-3">
                        <dt class="col-4 text-muted">Độc giả</dt>
                        <dd class="col-8 fw-semibold">@pm.TenDocGia <span class="badge bg-secondary ms-1">@pm.Lop</span></dd>

                        <dt class="col-4 text-muted">Ngày mượn</dt>
                        <dd class="col-8">@pm.NgayMuon.ToString("dd/MM/yyyy")</dd>

                        <dt class="col-4 text-muted">Hạn trả</dt>
                        <dd class="col-8">
                            @pm.NgayHanTra.ToString("dd/MM/yyyy")
                            @if (pm.SoNgayTreHan > 0 && coTheTra)
                            {
                                <span class="badge bg-danger ms-1">Trễ @pm.SoNgayTreHan ngày</span>
                            }
                        </dd>
                    </dl>

                    <table class="table table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Tên sách</th>
                                <th>Tác giả</th>
                                <th>Vị trí</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in pm.DanhSachSach)
                            {
                                <tr>
                                    <td class="fw-semibold">@s.TenSach</td>
                                    <td class="small text-muted">@s.TenTacGia</td>
                                    <td class="small text-muted">@(s.ViTri ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Form trả sách -->
        <div class="col-md-5">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-success-subtle fw-semibold">
                    <i class="bi bi-check2-square me-1"></i>Xác nhận trả sách
                </div>
                <div class="card-body">
                    @if (!coTheTra)
                    {
                        <div class="alert alert-secondary mb-0">
                            <i class="bi bi-info-circle me-1"></i>Phiếu mượn này đã được trả trước đó.
                        </div>
                    }
                    else
                    {
                        <form asp-action="LapPhieu" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="maPhieuMuon" value="@pm.MaPhieuMuon" />

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Tình trạng sách</label>
                                <select name="trangThaiSach" id="trangThaiSach" class="form-select">
                                    <option value="1">Bình thường</option>
                                    <option value="2">Hư hỏng (+50.000 đ)</option>
                                    <option value="3">Mất sách (+200.000 đ)</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Ghi chú <span class="text-muted fw-normal">(tuỳ chọn)</span></label>
                                <textarea name="ghiChu" class="form-control" rows="2" maxlength="500"></textarea>
                            </div>

                            <div class="border rounded p-2 mb-3 bg-light small">
                                <div class="d-flex justify-content-between">
                                    <span>Phạt trễ hạn (@pm.SoNgayTreHan ngày × @mucPhat.ToString("N0") đ)</span>
                                    <span>@phatTreHan.ToString("N0") đ</span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span>Phạt tình trạng sách</span>
                                    <span id="phatTinhTrang">0 đ</span>
                                </div>
                                <hr class="my-1" />
                                <div class="d-flex justify-content-between fw-bold text-danger">
                                    <span>Tổng tiền phạt (ước tính)</span>
                                    <span id="tongPhat">@phatTreHan.ToString("N0") đ</span>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-success w-100"
                                    onclick="return confirm('Xác nhận trả sách cho phiếu mượn #@pm.MaPhieuMuon?')">
                                <i class="bi bi-check-lg me-1"></i>Xác nhận trả sách
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
<script>
(() => {
    const select = document.getElementById('trangThaiSach');
    if (!select) return;
    const phatTreHan = @((long)phatTreHan);
    const phatThem = { '1': 0, '2': 50000, '3': 200000 };
    const fmt = n => n.toLocaleString('vi-VN') + ' đ';
    select.addEventListener('change', () => {
        const them = phatThem[select.value] || 0;
        document.getElementById('phatTinhTrang').textContent = fmt(them);
        document.getElementById('tongPhat').textContent = fmt(phatTreHan + them);
    });
})();
</script>
}
