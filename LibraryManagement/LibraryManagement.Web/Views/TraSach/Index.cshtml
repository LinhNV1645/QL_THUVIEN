@model IEnumerable<PhieuTraDto>
@using LibraryManagement.Application.DTOs.TraSach
@{
    ViewData["Title"] = "Quản lý trả sách";
    var chuaThuPhat = Model.Where(p => !p.DaThuPhat && p.TienPhat > 0).ToList();
    var daThuPhat = Model.Where(p => p.DaThuPhat || p.TienPhat == 0).ToList();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold mb-0"><i class="bi bi-arrow-return-left me-2 text-success"></i>Quản lý trả sách</h4>
    <a asp-action="LapPhieu" class="btn btn-success btn-sm">
        <i class="bi bi-plus-lg me-1"></i>Lập phiếu trả
    </a>
</div>

<!-- Tabs -->
<ul class="nav nav-tabs mb-3" id="traSachTab">
    <li class="nav-item">
        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#chuaThuPhat">
            Chưa thu phạt
            @if (chuaThuPhat.Any())
            {
                <span class="badge bg-danger ms-1">@chuaThuPhat.Count()</span>
            }
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#daThuPhat">
            Đã hoàn tất <span class="badge bg-secondary ms-1">@daThuPhat.Count</span>
        </button>
    </li>
</ul>

<div class="tab-content">
    <!-- Tab Chưa thu phạt -->
    <div class="tab-pane fade show active" id="chuaThuPhat">
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0 align-middle">
                        <thead class="table-success">
                            <tr>
                                <th class="px-3">Mã phiếu</th>
                                <th>Độc giả</th>
                                <th>Ngày trả</th>
                                <th class="text-center">Số ngày trễ</th>
                                <th class="text-end">Tiền phạt</th>
                                <th class="text-center">Tình trạng sách</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!chuaThuPhat.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-4">
                                        <i class="bi bi-check-circle fs-4 d-block mb-1 text-success"></i>
                                        Không có phiếu trả nào chưa thu phạt.
                                    </td>
                                </tr>
                            }
                            @foreach (var p in chuaThuPhat)
                            {
                                <tr>
                                    <td class="px-3"><span class="badge bg-primary-subtle text-primary border">#@p.MaPhieuTra</span></td>
                                    <td class="fw-semibold">@p.TenDocGia</td>
                                    <td class="small">@p.NgayTra.ToString("dd/MM/yyyy")</td>
                                    <td class="text-center">
                                        @if (p.SoNgayTreHan > 0)
                                        {
                                            <span class="badge bg-danger">+@p.SoNgayTreHan ngày</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                    <td class="text-end fw-semibold @(p.TienPhat > 0 ? "text-danger" : "")">
                                        @(p.TienPhat > 0 ? p.TienPhat.ToString("N0") + " đ" : "—")
                                    </td>
                                    <td class="text-center">
                                        @{
                                            var (ttLabel, ttClass) = p.TrangThaiSach switch {
                                                2 => ("Hư hỏng", "bg-warning text-dark"),
                                                3 => ("Mất", "bg-danger"),
                                                _ => ("Bình thường", "bg-success")
                                            };
                                        }
                                        <span class="badge @ttClass">@ttLabel</span>
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="Detail" asp-route-id="@p.MaPhieuTra"
                                           class="btn btn-outline-info btn-sm px-2" title="Chi tiết">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (p.TienPhat > 0)
                                        {
                                            <form asp-action="ThuPhat" asp-route-id="@p.MaPhieuTra" method="post" class="d-inline"
                                                  onsubmit="return confirm('Xác nhận đã thu @p.TienPhat.ToString("N0") đồng tiền phạt?')">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-warning btn-sm px-2" title="Thu phạt">
                                                    <i class="bi bi-cash-coin"></i>
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Tab Đã thu phạt -->
    <div class="tab-pane fade" id="daThuPhat">
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th class="px-3">Mã phiếu</th>
                                <th>Độc giả</th>
                                <th>Ngày trả</th>
                                <th class="text-center">Số ngày trễ</th>
                                <th class="text-end">Tiền phạt</th>
                                <th class="text-center">Tình trạng sách</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!daThuPhat.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-4">
                                        <i class="bi bi-inbox fs-4 d-block mb-1"></i>Chưa có phiếu nào.
                                    </td>
                                </tr>
                            }
                            @foreach (var p in daThuPhat)
                            {
                                <tr>
                                    <td class="px-3"><span class="badge bg-secondary-subtle text-secondary border">#@p.MaPhieuTra</span></td>
                                    <td>@p.TenDocGia</td>
                                    <td class="small">@p.NgayTra.ToString("dd/MM/yyyy")</td>
                                    <td class="text-center">
                                        @(p.SoNgayTreHan > 0 ? $"+{p.SoNgayTreHan} ngày" : "—")
                                    </td>
                                    <td class="text-end">@(p.TienPhat > 0 ? p.TienPhat.ToString("N0") + " đ" : "—")</td>
                                    <td class="text-center">
                                        @{
                                            var (l2, c2) = p.TrangThaiSach switch {
                                                2 => ("Hư hỏng", "bg-warning text-dark"),
                                                3 => ("Mất", "bg-danger"),
                                                _ => ("Bình thường", "bg-success")
                                            };
                                        }
                                        <span class="badge @c2">@l2</span>
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="Detail" asp-route-id="@p.MaPhieuTra"
                                           class="btn btn-outline-info btn-sm px-2" title="Chi tiết">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
