@using LibraryManagement.Application.DTOs.ThongKe
@{
    ViewData["Title"] = "Thống kê";
    int thang = ViewBag.Thang ?? DateTime.Today.Month;
    int nam = ViewBag.Nam ?? DateTime.Today.Year;
    var sachList = ViewBag.SachMuonNhieu as List<SachMuonNhieuDto> ?? [];
    var docGiaList = ViewBag.DocGiaMuonNhieu as List<DocGiaMuonNhieuDto> ?? [];
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="bi bi-bar-chart me-2 text-success"></i>Thống kê</h4>
</div>

<!-- Bộ chọn tháng/năm + xuất Excel -->
<div class="card shadow-sm mb-4">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label small mb-1">Tháng</label>
                <select name="thang" class="form-select form-select-sm" style="width:100px">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(m == thang)">Tháng @m</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label small mb-1">Năm</label>
                <select name="nam" class="form-select form-select-sm" style="width:90px">
                    @for (int y = DateTime.Today.Year; y >= DateTime.Today.Year - 4; y--)
                    {
                        <option value="@y" selected="@(y == nam)">@y</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="bi bi-funnel me-1"></i>Xem thống kê
                </button>
            </div>
            <div class="col-auto ms-auto d-flex gap-2">
                <a asp-action="ExportThongKe" asp-route-thang="@thang" asp-route-nam="@nam"
                   class="btn btn-outline-success btn-sm">
                    <i class="bi bi-file-earmark-excel me-1"></i>Xuất thống kê
                </a>
                <a asp-action="ExportLichSuMuon" asp-route-thang="@thang" asp-route-nam="@nam"
                   class="btn btn-outline-success btn-sm">
                    <i class="bi bi-file-earmark-arrow-down me-1"></i>Lịch sử mượn
                </a>
                <a asp-action="ExportSach"
                   class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-file-earmark-spreadsheet me-1"></i>DS sách
                </a>
            </div>
        </form>
    </div>
</div>

<div class="alert alert-light border mb-3 py-2">
    <i class="bi bi-calendar3 me-2 text-success"></i>
    Dữ liệu thống kê tháng <strong>@thang</strong> năm <strong>@nam</strong>
</div>

<div class="row g-4">
    <!-- Top sách mượn nhiều -->
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header py-2 d-flex justify-content-between align-items-center">
                <span><i class="bi bi-book-fill me-2 text-success"></i>Top 10 sách mượn nhiều nhất</span>
                <span class="badge bg-success">@sachList.Count sách</span>
            </div>
            <div class="card-body p-0">
                @if (!sachList.Any())
                {
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-inbox fs-3 d-block mb-1"></i>
                        Không có dữ liệu cho tháng này.
                    </div>
                }
                else
                {
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3" style="width:40px">#</th>
                                <th>Tên sách</th>
                                <th>Tác giả</th>
                                <th class="text-center">Lượt mượn</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int rank = 1; }
                            @foreach (var s in sachList)
                            {
                                var medalClass = rank switch { 1 => "text-warning", 2 => "text-secondary", 3 => "text-danger", _ => "text-muted" };
                                var medalIcon = rank switch { 1 => "bi-trophy-fill", 2 => "bi-award-fill", 3 => "bi-award", _ => "bi-circle-fill" };
                                <tr>
                                    <td class="ps-3">
                                        <i class="bi @medalIcon @medalClass" style="font-size:@(rank <= 3 ? "1rem" : ".6rem")"></i>
                                    </td>
                                    <td>
                                        <div class="fw-semibold small">@s.TenSach</div>
                                        <div class="text-muted" style="font-size:.75rem">@s.TenTheLoai</div>
                                    </td>
                                    <td class="text-muted small">@s.TenTacGia</td>
                                    <td class="text-center">
                                        <span class="badge bg-success rounded-pill">@s.SoLuotMuon</span>
                                    </td>
                                </tr>
                                rank++;
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    <!-- Top độc giả mượn nhiều -->
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header py-2 d-flex justify-content-between align-items-center">
                <span><i class="bi bi-people-fill me-2 text-success"></i>Top 10 độc giả mượn nhiều nhất</span>
                <span class="badge bg-success">@docGiaList.Count người</span>
            </div>
            <div class="card-body p-0">
                @if (!docGiaList.Any())
                {
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-inbox fs-3 d-block mb-1"></i>
                        Không có dữ liệu cho tháng này.
                    </div>
                }
                else
                {
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3" style="width:40px">#</th>
                                <th>Họ tên</th>
                                <th>Lớp</th>
                                <th class="text-center">Lần mượn</th>
                                <th class="text-center">Tổng sách</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int rankD = 1; }
                            @foreach (var d in docGiaList)
                            {
                                var medalClass = rankD switch { 1 => "text-warning", 2 => "text-secondary", 3 => "text-danger", _ => "text-muted" };
                                var medalIcon = rankD switch { 1 => "bi-trophy-fill", 2 => "bi-award-fill", 3 => "bi-award", _ => "bi-circle-fill" };
                                <tr>
                                    <td class="ps-3">
                                        <i class="bi @medalIcon @medalClass" style="font-size:@(rankD <= 3 ? "1rem" : ".6rem")"></i>
                                    </td>
                                    <td class="fw-semibold small">@d.HoTen</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(d.Lop))
                                        { <span class="badge bg-secondary">@d.Lop</span> }
                                        else { <span class="text-muted">—</span> }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-primary rounded-pill">@d.SoLanMuon</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-info text-dark rounded-pill">@d.TongSachMuon</span>
                                    </td>
                                </tr>
                                rankD++;
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>
