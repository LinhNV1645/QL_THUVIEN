@model IEnumerable<LibraryManagement.Application.DTOs.MuonSach.PhieuMuonQuaHanDto>
@{
    ViewData["Title"] = "Phiếu mượn quá hạn";
    var list = Model?.ToList() ?? [];
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">
        <i class="bi bi-exclamation-triangle me-2 text-danger"></i>Phiếu mượn quá hạn
        @if (list.Any())
        {
            <span class="badge bg-danger ms-1">@list.Count</span>
        }
    </h4>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
    </a>
</div>

<partial name="_DanhSachQuaHan" model="list" />
