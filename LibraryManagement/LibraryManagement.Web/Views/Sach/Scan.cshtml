@using LibraryManagement.Application.DTOs.Sach
@model SachDto?
@{
    Layout = null; // Trang độc lập, không cần sidebar/login
    ViewData["Title"] = Model != null ? Model.TenSach : "Không tìm thấy sách";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Thư viện THCS Thanh Tuân</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <style>
        body { background: #f0f7f0; min-height: 100vh; }
        .brand-bar { background: #198754; color: #fff; padding: 12px 16px; }
        .card-info { border-radius: 16px; border: none; box-shadow: 0 4px 20px rgba(0,0,0,.10); }
        .badge-tl { background: #198754; }
        .stat-box { background: #f8f9fa; border-radius: 10px; padding: 10px 14px; }
        .ton-badge { font-size: 1rem; padding: 6px 14px; }
    </style>
</head>
<body>
    <!-- Header thư viện -->
    <div class="brand-bar d-flex align-items-center gap-2 mb-4">
        <i class="bi bi-book-half fs-4"></i>
        <div>
            <div class="fw-bold" style="font-size:1rem">Thư viện THCS Thanh Tuân</div>
            <div style="font-size:.75rem;opacity:.85">Hà Nội — Thông tin sách</div>
        </div>
    </div>

    <div class="container" style="max-width:480px">
        @if (Model == null)
        {
            <div class="card card-info p-4 text-center">
                <i class="bi bi-question-circle text-secondary" style="font-size:3rem"></i>
                <h5 class="mt-3 text-secondary">Không tìm thấy sách</h5>
                <p class="text-muted small">Mã QR này không khớp với bất kỳ cuốn sách nào trong hệ thống.</p>
            </div>
        }
        else
        {
            <div class="card card-info mb-3">
                <div class="card-body p-4">
                    <!-- Tên sách -->
                    <h4 class="fw-bold text-dark mb-1">@Model.TenSach</h4>
                    <span class="badge badge-tl mb-3">@(Model.TenTheLoai ?? "—")</span>

                    <!-- Thông tin -->
                    <table class="table table-sm table-borderless mb-3">
                        <tbody>
                            <tr>
                                <td class="text-muted" style="width:38%"><i class="bi bi-person me-1"></i>Tác giả</td>
                                <td class="fw-semibold">@(Model.TenTacGia ?? "—")</td>
                            </tr>
                            <tr>
                                <td class="text-muted"><i class="bi bi-building me-1"></i>NXB</td>
                                <td>@(Model.TenNXB ?? "—")</td>
                            </tr>
                            <tr>
                                <td class="text-muted"><i class="bi bi-calendar3 me-1"></i>Năm XB</td>
                                <td>@(Model.NamXuatBan?.ToString() ?? "—")</td>
                            </tr>
                            <tr>
                                <td class="text-muted"><i class="bi bi-file-text me-1"></i>Số trang</td>
                                <td>@(Model.SoTrang?.ToString() ?? "—")</td>
                            </tr>
                            <tr>
                                <td class="text-muted"><i class="bi bi-geo-alt me-1"></i>Vị trí</td>
                                <td class="fw-semibold text-primary">@(Model.ViTri ?? "—")</td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Tồn kho -->
                    <div class="stat-box d-flex align-items-center justify-content-between">
                        <span class="text-muted small"><i class="bi bi-archive me-1"></i>Sách hiện có trong kho</span>
                        @if (Model.SoLuongTon > 0)
                        {
                            <span class="badge bg-success ton-badge">@Model.SoLuongTon cuốn</span>
                        }
                        else
                        {
                            <span class="badge bg-danger ton-badge">Hết sách</span>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(Model.MoTa))
                    {
                        <p class="text-muted small mt-3 mb-0"><i class="bi bi-chat-quote me-1"></i>@Model.MoTa</p>
                    }
                </div>
            </div>

            <p class="text-center text-muted small">
                <i class="bi bi-qr-code me-1"></i>Mã QR: @Model.MaQR
            </p>
        }
    </div>
</body>
</html>
