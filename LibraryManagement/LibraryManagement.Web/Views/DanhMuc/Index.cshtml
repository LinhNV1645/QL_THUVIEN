@{
    ViewData["Title"] = "Danh mục";
    var theLoais    = ViewBag.TheLoais    as List<LookupItemDto> ?? new();
    var tacGias     = ViewBag.TacGias     as List<LookupItemDto> ?? new();
    var nhaXuatBans = ViewBag.NhaXuatBans as List<LookupItemDto> ?? new();
}

<h4 class="fw-bold mb-3"><i class="bi bi-tags me-2 text-success"></i>Quản lý danh mục</h4>

<div class="row g-3">

    <!-- Thể loại -->
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-success text-white py-2 d-flex justify-content-between align-items-center">
                <span><i class="bi bi-bookmark me-1"></i>Thể loại</span>
                <span class="badge bg-white text-success">@theLoais.Count</span>
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush" style="max-height:340px;overflow-y:auto">
                    @if (!theLoais.Any())
                    {
                        <li class="list-group-item text-muted small text-center py-3">Chưa có thể loại.</li>
                    }
                    @foreach (var tl in theLoais)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center py-2 px-3">
                            <span class="small">@tl.Ten</span>
                            <form asp-action="DeleteTheLoai" asp-route-id="@tl.Id" method="post"
                                  onsubmit="return confirm('Xóa thể loại «@tl.Ten»?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm px-2 py-0" title="Xóa">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </li>
                    }
                </ul>
            </div>
            <div class="card-footer p-2">
                <form asp-action="AddTheLoai" method="post" class="d-flex gap-2">
                    @Html.AntiForgeryToken()
                    <input type="text" name="tenTheLoai" class="form-control form-control-sm"
                           placeholder="Tên thể loại mới..." required maxlength="100" />
                    <button type="submit" class="btn btn-success btn-sm px-3">
                        <i class="bi bi-plus-lg"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Tác giả -->
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-success text-white py-2 d-flex justify-content-between align-items-center">
                <span><i class="bi bi-person-lines-fill me-1"></i>Tác giả</span>
                <span class="badge bg-white text-success">@tacGias.Count</span>
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush" style="max-height:340px;overflow-y:auto">
                    @if (!tacGias.Any())
                    {
                        <li class="list-group-item text-muted small text-center py-3">Chưa có tác giả.</li>
                    }
                    @foreach (var tg in tacGias)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center py-2 px-3">
                            <span class="small">@tg.Ten</span>
                            <form asp-action="DeleteTacGia" asp-route-id="@tg.Id" method="post"
                                  onsubmit="return confirm('Xóa tác giả «@tg.Ten»?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm px-2 py-0" title="Xóa">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </li>
                    }
                </ul>
            </div>
            <div class="card-footer p-2">
                <form asp-action="AddTacGia" method="post" class="d-flex gap-2">
                    @Html.AntiForgeryToken()
                    <input type="text" name="tenTacGia" class="form-control form-control-sm"
                           placeholder="Tên tác giả mới..." required maxlength="150" />
                    <button type="submit" class="btn btn-success btn-sm px-3">
                        <i class="bi bi-plus-lg"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Nhà xuất bản -->
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-success text-white py-2 d-flex justify-content-between align-items-center">
                <span><i class="bi bi-building me-1"></i>Nhà xuất bản</span>
                <span class="badge bg-white text-success">@nhaXuatBans.Count</span>
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush" style="max-height:340px;overflow-y:auto">
                    @if (!nhaXuatBans.Any())
                    {
                        <li class="list-group-item text-muted small text-center py-3">Chưa có NXB.</li>
                    }
                    @foreach (var nxb in nhaXuatBans)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center py-2 px-3">
                            <span class="small">@nxb.Ten</span>
                            <form asp-action="DeleteNXB" asp-route-id="@nxb.Id" method="post"
                                  onsubmit="return confirm('Xóa NXB «@nxb.Ten»?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm px-2 py-0" title="Xóa">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </li>
                    }
                </ul>
            </div>
            <div class="card-footer p-2">
                <form asp-action="AddNXB" method="post" class="d-flex gap-2">
                    @Html.AntiForgeryToken()
                    <input type="text" name="tenNXB" class="form-control form-control-sm"
                           placeholder="Tên NXB mới..." required maxlength="150" />
                    <button type="submit" class="btn btn-success btn-sm px-3">
                        <i class="bi bi-plus-lg"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>

</div>
