@model DocGiaDto
@{
    ViewData["Title"] = "Chi tiết độc giả";
    var lichSu = ViewBag.LichSu as IEnumerable<LichSuMuonDto> ?? Enumerable.Empty<LichSuMuonDto>();
}

<div class="d-flex align-items-center mb-3 gap-2">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h4 class="fw-bold mb-0"><i class="bi bi-person-circle me-2 text-success"></i>Chi tiết độc giả</h4>
</div>

<!-- Thông tin cơ bản -->
<div class="card shadow-sm mb-3" style="max-width:640px">
    <div class="card-header bg-success text-white py-2">
        <i class="bi bi-person me-1"></i>Thông tin độc giả
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4 text-muted small">Mã độc giả</dt>
            <dd class="col-sm-8 font-monospace">#@Model.MaDocGia</dd>

            <dt class="col-sm-4 text-muted small">Họ tên</dt>
            <dd class="col-sm-8 fw-semibold">@Model.HoTen</dd>

            <dt class="col-sm-4 text-muted small">Lớp</dt>
            <dd class="col-sm-8">@(Model.Lop ?? "—")</dd>

            <dt class="col-sm-4 text-muted small">Ngày sinh</dt>
            <dd class="col-sm-8">@(Model.NgaySinh?.ToString("dd/MM/yyyy") ?? "—")</dd>

            <dt class="col-sm-4 text-muted small">Giới tính</dt>
            <dd class="col-sm-8">@(Model.GioiTinh switch { true => "Nam", false => "Nữ", _ => "—" })</dd>

            <dt class="col-sm-4 text-muted small">Địa chỉ</dt>
            <dd class="col-sm-8">@(Model.DiaChi ?? "—")</dd>

            <dt class="col-sm-4 text-muted small">Email</dt>
            <dd class="col-sm-8">@(Model.Email ?? "—")</dd>

            <dt class="col-sm-4 text-muted small">Số điện thoại</dt>
            <dd class="col-sm-8">@(Model.SoDienThoai ?? "—")</dd>

            <dt class="col-sm-4 text-muted small">Ngày đăng ký</dt>
            <dd class="col-sm-8">@Model.NgayDangKy.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-4 text-muted small">Trạng thái</dt>
            <dd class="col-sm-8">
                @if (Model.TrangThai == 1)
                {
                    <span class="badge bg-success">Hoạt động</span>
                }
                else
                {
                    <span class="badge bg-danger">Đã khóa</span>
                }
            </dd>
        </dl>
    </div>
</div>

<!-- Actions -->
<div class="d-flex gap-2 mb-4">
    <a asp-action="Edit" asp-route-id="@Model.MaDocGia" class="btn btn-warning btn-sm">
        <i class="bi bi-pencil me-1"></i>Chỉnh sửa
    </a>
    <form asp-action="ToggleTrangThai" asp-route-id="@Model.MaDocGia" method="post" class="d-inline">
        @Html.AntiForgeryToken()
        <button type="submit"
                class="btn btn-sm @(Model.TrangThai == 1 ? "btn-outline-danger" : "btn-outline-success")">
            <i class="bi @(Model.TrangThai == 1 ? "bi-lock" : "bi-unlock") me-1"></i>
            @(Model.TrangThai == 1 ? "Khóa tài khoản" : "Kích hoạt")
        </button>
    </form>
</div>

<!-- Lịch sử mượn -->
<div class="card shadow-sm">
    <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
        <span class="fw-semibold"><i class="bi bi-clock-history me-1"></i>Lịch sử mượn sách</span>
        <span class="badge bg-secondary">@lichSu.Count() lần</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th class="px-3">Mã phiếu</th>
                        <th>Tên sách</th>
                        <th>Ngày mượn</th>
                        <th>Hạn trả</th>
                        <th>Ngày trả</th>
                        <th>Tình trạng</th>
                        <th class="text-end px-3">Tiền phạt</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!lichSu.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-3">
                                <i class="bi bi-inbox me-1"></i>Chưa có lịch sử mượn.
                            </td>
                        </tr>
                    }
                    @foreach (var ls in lichSu)
                    {
                        <tr>
                            <td class="px-3 font-monospace small">#@ls.MaPhieuMuon</td>
                            <td class="small">@ls.TenSach</td>
                            <td class="small">@ls.NgayMuon.ToString("dd/MM/yyyy")</td>
                            <td class="small @(ls.NgayTra == null && ls.NgayHanTra < DateOnly.FromDateTime(DateTime.Today) ? "text-danger fw-semibold" : "")">
                                @ls.NgayHanTra.ToString("dd/MM/yyyy")
                            </td>
                            <td class="small">@(ls.NgayTra?.ToString("dd/MM/yyyy") ?? "—")</td>
                            <td>
                                <span class="badge @(ls.TinhTrangTra == "Đã trả" ? "bg-success-subtle text-success border border-success" :
                                                     ls.TinhTrangTra == "Quá hạn" ? "bg-danger-subtle text-danger border border-danger" :
                                                     "bg-warning-subtle text-warning border border-warning")">
                                    @ls.TinhTrangTra
                                </span>
                            </td>
                            <td class="text-end px-3 small @(ls.TienPhat > 0 ? "text-danger fw-semibold" : "text-muted")">
                                @(ls.TienPhat > 0 ? ls.TienPhat.ToString("N0") + " đ" : "—")
                            </td>
                        </tr>
                    }
                </tbody>
                @if (lichSu.Any(ls => ls.TienPhat > 0))
                {
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="6" class="text-end fw-semibold px-3 small">Tổng tiền phạt:</td>
                            <td class="text-end px-3 fw-bold text-danger small">
                                @lichSu.Sum(ls => ls.TienPhat).ToString("N0") đ
                            </td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>
</div>
