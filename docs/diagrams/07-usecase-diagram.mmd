            UC4["Quản lý kho sách\n(CRUD + QR Code)"]:::ucStaff
            UC5["Quản lý độc giả\n(CRUD + lịch sử)"]:::ucStaff
            UC6["Quản lý danh mục\n(Thể loại, Tác giả, NXB)"]:::ucStaff
            UC7["Lập phiếu mượn\n(kiểm tra tồn kho)"]:::ucStaff
            UC8["Gia hạn phiếu mượn"]:::ucStaff
            UC10["Trả sách\n(tính tiền phạt)"]:::ucStaff
            UC11["Thu tiền phạt"]:::ucStaff
            UC12["Xem thống kê\n(tháng/năm)"]:::ucStaff
            UC13["Xuất Excel\n(sách, lịch sử, thống kê)"]:::ucStaff
        end

        subgraph UC_PUBLIC["Công khai"]
            UC14["Tìm kiếm sách\n(không cần đăng nhập)"]:::ucPublic
        end
    end

