            UC1["Quản lý tài khoản\nnhân viên"]:::ucAdmin
            UC2["Cấu hình hệ thống\n(ngày mượn, phạt...)"]:::ucAdmin
            UC9["Xem Job Monitor\n(Hangfire Dashboard)"]:::ucAdmin
        end

        subgraph UC_STAFF["Admin + Nhân viên"]
