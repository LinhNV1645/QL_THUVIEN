    classDef uc fill:#F5F5F5,stroke:#616161,color:#212121
    classDef ucAdmin fill:#FCE4EC,stroke:#E91E63,color:#880E4F
    classDef ucStaff fill:#E8F5E9,stroke:#4CAF50,color:#1B5E20
